// =====================================================================================================
//  SMC Multi-Timeframe Bollinger Pullback + CHOCH Scalping Strategy
// -----------------------------------------------------------------------------------------------------
//  Dos motores de entrada:
//   A) PULLBACK BB (a favor de la tendencia MTF):
//        - Tendencia 4h (estructura + precio vs. media BB 4h) y 1h (estructura) alineadas.
//        - Retroceso del LTF a la banda de Bollinger contraria + toma de liquidez + patrón de giro.
//   B) SCALP CHOCH (agresivo, pensado para 15m / 5m / 1m):
//        - El precio viene cayendo (estructura LTF bajista), toma liquidez y hace un CHOCH alcista
//          en el timeframe del gráfico -> entrada (y viceversa para cortos).
//
//  Clasificación de cada entrada según la confluencia con los timeframes superiores
//  (funciona igual en 15m, 5m o 1m):
//        SCALP     -> sólo el LTF confirma.                  Objetivo corto (R:R scalp), salida rápida.
//        INTRADÍA  -> LTF + estructura de 1h a favor.        Objetivo mayor, parcial en 1R y breakeven.
//        SWING     -> LTF + 1h + 4h a favor.                 Objetivo grande, parcial, BE y trailing stop.
//  Si se entra como SCALP y después la 1h (y/o la 4h) confirma en la misma dirección (p. ej. un CHOCH
//  de 1h a favor), la operación se "asciende" (upgrade) a INTRADÍA / SWING: se amplía el TP, se mueve
//  el SL a breakeven y se deja correr el beneficio.
//
//  Anti-repintado: los datos de 4h y 1h se solicitan con request.security(..., expr[1], lookahead_on),
//  es decir, sólo se usan velas HTF CERRADAS.
// =====================================================================================================
//@version=5
strategy("SMC MTF Bollinger + CHOCH Scalping Strategy",
     shorttitle         = "SMC-MTF-BB",
     overlay            = true,
     initial_capital    = 10000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 10,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.04,
     slippage           = 1,
     pyramiding         = 0,
     calc_on_every_tick = false,
     max_boxes_count    = 500,
     max_lines_count    = 500,
     max_labels_count   = 500,
     max_bars_back      = 500)

// =====================================================================================================
// 1. INPUTS (Panel de control)
// =====================================================================================================
G_TF    = "⏱ Timeframes"
G_MODE  = "🎯 Motores de entrada"
G_BB    = "📈 Bandas de Bollinger"
G_MS    = "🏛 Estructura de mercado (BOS / CHOCH)"
G_SCALP = "⚡ Scalp CHOCH (15m / 5m / 1m)"
G_SMC   = "💧 Filtros SMC (Liquidez / FVG)"
G_REV   = "🔄 Confirmación de giro (Pullback BB)"
G_RISK  = "🛡 Gestión de riesgo por tipo de entrada"
G_FILT  = "🧪 Filtros de calidad (afinar)"
G_RANGE = "↔ Modo rango (lateral): scalps rápidos"
G_VIS   = "🎨 Visualización"
G_DATE  = "📅 Rango de backtest"

// --- Timeframes ---
autoTf    = input.bool(true, "Timeframes automáticos según el gráfico", group = G_TF,
     tooltip = "Gráfico 1m–30m → confirmación 1h y macro 4h. Gráfico 1h → 4h y Diario. Gráfico 2h–4h → Diario y Semanal. Así se puede hacer backtest en 1h/4h con años de historia. Desactivar para usar los timeframes manuales de abajo.")
tfMacroIn   = input.timeframe("240", "MTF1 · Macro-tendencia (manual)", group = G_TF)
tfConfirmIn = input.timeframe("60",  "MTF2 · Confirmación (manual)",    group = G_TF)
chartSec  = timeframe.in_seconds(timeframe.period)
tfConfirm = autoTf ? (chartSec <= 1800 ? "60"  : chartSec <= 3600 ? "240" : chartSec <= 14400 ? "D" : "W") : tfConfirmIn
tfMacro   = autoTf ? (chartSec <= 1800 ? "240" : chartSec <= 3600 ? "D"   : chartSec <= 14400 ? "W" : "M") : tfMacroIn
tfEntry   = input.timeframe("5",   "LTF · Entrada (debe coincidir con el gráfico)", options = ["60", "15", "5", "1"], group = G_TF,
     tooltip = "La estrategia ejecuta órdenes en el timeframe del gráfico. Selecciona aquí el LTF deseado y abre el gráfico en ese mismo timeframe. Si no coinciden se muestra un aviso y, opcionalmente, se bloquean las entradas.")
blockOnTfMismatch = input.bool(true, "Bloquear entradas si el gráfico ≠ LTF", group = G_TF)

// --- Motores ---
entryEngine = input.string("Respaldo D+4h+1h (5m)", "Motor de entrada", options = ["Respaldo D+4h+1h (5m)", "Ruptura BB con tendencia", "Ruptura + Pullback + Scalp", "Ambos (Pullback + Scalp CHOCH)", "Sólo Pullback BB", "Sólo Scalp CHOCH"], group = G_MODE,
     tooltip = "Ruptura BB con tendencia: el único motor con ventaja en el backtest (6 años, BTC/ETH/SOL/oro, gráfico 4h). Pullback y Scalp CHOCH quedan como opción: en el backtest de 1 año (5m/15m/1h) no mostraron ventaja después de comisiones.")
rrBreakout  = input.float(3.0, "Ruptura: objetivo (R)", minval = 1, step = 0.5, group = G_MODE)
G_RS        = "✅ Respaldo D+4h+1h (entradas de 5m)"
rsTriggers  = input.string("CHOCH + Ruptura BB", "Gatillos de 5m", options = ["CHOCH + Ruptura BB", "Sólo CHOCH", "Sólo Ruptura BB"], group = G_RS,
     tooltip = "CHOCH: el 5m retrocede contra la tendencia mayor, toma liquidez y hace un CHOCH a favor. Ruptura BB: el 5m cierra fuera de la banda a favor de la tendencia. Ambos sólo cuentan si Diario, 4h y 1h están a favor.")
rsNeedLiq   = input.bool(true, "CHOCH: exigir toma de liquidez previa", group = G_RS)
rsAntic     = input.bool(true, "Gráfico < 15m: sólo entradas anticipadas (15m todavía en retroceso)", group = G_RS,
     tooltip = "Backtest 1 año BTC/ETH 5m con respaldo D+4h+1h: si el 15m todavía está en contra (retroceso) la señal de 5m dio +0.26R por operación; si el 15m ya giró a favor, sólo +0.05R. Entrar anticipando el giro del 15m da mejor precio.")
rsMoveBE    = input.bool(false, "Mover SL a la entrada", group = G_RS, inline = "rsbe",
     tooltip = "Backtest 1 año (réplica exacta del Probador): mover el SL a la entrada en +1R hizo perder (BTC 5m -21%) porque el precio suele volver a la entrada antes de seguir; con stop fijo y objetivo 3R: BTC 5m +9.7%, BTC 15m +11.5%, ETH 15m +8.2%. Moverlo en +2R tampoco mejoró.")
rsBeR       = input.float(2.0, "en (R)", minval = 0.5, step = 0.25, group = G_RS, inline = "rsbe")
rsMgmt      = input.string("Dejar correr a 3R", "Gestión (para el Probador)", options = ["Dejar correr a 3R", "Scalp 1R", "Mitad 1R + mitad 3R"], group = G_RS,
     tooltip = "Cada etiqueta muestra los dos objetivos: TP1 scalp (1R) y TP2 tendencia (3R). Backtest 1 año sin costos, con respaldo: dejar correr a 3R BTC 5m +33% / 15m +18%, ETH 5m +14% / 15m +12%; scalp 1R BTC 5m +6% / 15m +11%, ETH +7% / +8% (acierta 52-55%). Mitad y mitad queda en el medio.")
rsScalpR    = input.float(1.0, "TP1 scalp (R)", minval = 0.5, step = 0.25, group = G_RS)
rsTargetR   = input.float(3.0, "TP2 tendencia (R)", minval = 1, step = 0.5, group = G_RS,
     tooltip = "Objetivo fijo en R. Backtest 1 año con stop fijo: 3R fue la mejor combinación.")
allowLong   = input.bool(true, "Permitir largos", group = G_MODE)
allowShort  = input.bool(true, "Permitir cortos", group = G_MODE)
useRS       = entryEngine == "Respaldo D+4h+1h (5m)"
useBreakout = entryEngine == "Ruptura BB con tendencia" or entryEngine == "Ruptura + Pullback + Scalp"
usePullback = entryEngine == "Ruptura + Pullback + Scalp" or entryEngine == "Ambos (Pullback + Scalp CHOCH)" or entryEngine == "Sólo Pullback BB"
useScalp    = entryEngine == "Ruptura + Pullback + Scalp" or entryEngine == "Ambos (Pullback + Scalp CHOCH)" or entryEngine == "Sólo Scalp CHOCH"

// --- Bollinger ---
bbLen  = input.int(20,    "Longitud",            minval = 1,   group = G_BB)
bbMult = input.float(2.0, "Desviación estándar", minval = 0.1, step = 0.1, group = G_BB)
bbSrc  = input.source(close, "Fuente (LTF)", group = G_BB)

// --- Estructura ---
pivLenHTF = input.int(3, "Longitud fractal HTF (4h / 1h)", minval = 1, group = G_MS,
     tooltip = "Número de velas a cada lado para confirmar un swing high/low (fractal) en 4h y 1h.")
use4hBasisFilter = input.bool(true, "4h: exigir precio vs. media central BB 4h", group = G_MS)
use1hStructure   = input.bool(true, "Pullback BB: exigir estructura 1h alineada", group = G_MS)
recent1hBars     = input.int(3, "CHOCH 1h 'reciente' (velas de 1h)", minval = 1, group = G_MS,
     tooltip = "Si el CHOCH de 1h ocurrió hace como máximo estas velas de 1h, la etiqueta de la entrada lo indica (p. ej. 'CHOCH 5m + CHOCH 1h').")

// --- Scalp CHOCH ---
pivLenScalp     = input.int(2, "Longitud fractal estructura LTF", minval = 1, group = G_SCALP,
     tooltip = "Fractal usado para BOS/CHOCH en el timeframe del gráfico. Valores bajos (2) = más agresivo, más señales. 3 es un buen equilibrio en 15m.")
scalpReqLiq     = input.bool(true, "Exigir toma de liquidez antes del CHOCH", group = G_SCALP,
     tooltip = "Barrido de un swing previo, toque de la banda BB del LTF / BB 1h o toque de un FVG en contra dentro de la ventana indicada.")
scalpLiqLookback = input.int(15, "Ventana toma de liquidez → CHOCH (velas)", minval = 1, group = G_SCALP)
scalpDispAtr    = input.float(0.0, "Desplazamiento mín. vela CHOCH (cuerpo x ATR)", minval = 0, step = 0.1, group = G_SCALP,
     tooltip = "0 = desactivado. Exige que la vela que rompe la estructura tenga un cuerpo de al menos X ATR (vela de desplazamiento / impulso).")
scalpBlockVs4h  = input.bool(false, "Bloquear scalps contra la tendencia de 4h", group = G_SCALP)
scalpEntryMode  = input.string("Mercado (cierre CHOCH)", "Tipo de orden scalp", options = ["Mercado (cierre CHOCH)", "Límite en retesteo del nivel roto"], group = G_SCALP)
scalpLimitExpiry = input.int(5, "Caducidad orden límite (velas)", minval = 1, group = G_SCALP)
scalpSlLookback = input.int(10, "SL scalp: extremo de las últimas N velas", minval = 2, group = G_SCALP)
scalpSlAtrBuf   = input.float(0.3, "SL scalp: colchón (x ATR)", minval = 0, step = 0.05, group = G_SCALP)
scalpMaxRiskAtr = input.float(3.0, "Riesgo máx. del scalp (x ATR, 0 = sin límite)", minval = 0, step = 0.5, group = G_SCALP,
     tooltip = "Descarta scalps cuyo stop quede demasiado lejos (vela CHOCH muy grande).")
allowReverse    = input.bool(true, "Permitir reversa directa desde un SCALP", group = G_SCALP,
     tooltip = "Si hay un SCALP abierto y aparece un CHOCH en contra con señal válida, se cierra y se abre en la dirección contraria.")
scalpCloseOnLtfChoch = input.bool(true, "Cerrar SCALP si hay CHOCH LTF en contra", group = G_SCALP)

// --- SMC ---
useSmcFilter   = input.bool(true, "Pullback BB: exigir confirmación SMC", group = G_SMC)
smcUseSweep    = input.bool(true, "· Barrido de swing previo del LTF",           group = G_SMC)
smcUseFvg      = input.bool(true, "· Toque de FVG (LTF y 1h)",                   group = G_SMC)
smcUseHtfLiq   = input.bool(true, "· Toque de bandas BB 4h / 1h (liquidez HTF)", group = G_SMC)
pivLenLTF      = input.int(5,  "Longitud fractal swings de liquidez LTF", minval = 1, group = G_SMC)
smcLookback    = input.int(10, "Ventana de validez del evento SMC (velas)", minval = 1, group = G_SMC)
nearBandAtr    = input.float(1.0, "Distancia máx. a la banda (x ATR)", minval = 0, step = 0.1, group = G_SMC,
     tooltip = "El evento de liquidez sólo cuenta si ocurre a menos de esta distancia (en ATRs) de la banda de Bollinger del LTF.")
fvgMinAtr      = input.float(0.0, "Tamaño mínimo FVG (x ATR)", minval = 0, step = 0.05, group = G_SMC)
maxFvgBoxes    = input.int(20, "Máx. FVG activos por dirección (LTF)", minval = 1, maxval = 100, group = G_SMC)

// --- Giro ---
useRevFilter    = input.bool(true, "Habilitar confirmación de giro", group = G_REV)
revPin          = input.bool(true, "· Pin bar",                     group = G_REV)
revEngulf       = input.bool(true, "· Vela envolvente",             group = G_REV)
revCrossBack    = input.bool(true, "· Cruce de vuelta de la banda", group = G_REV)
pinWickRatio    = input.float(0.6, "Pin bar: mecha mínima (% del rango)", minval = 0.3, maxval = 0.95, step = 0.05, group = G_REV)
bbTouchLookback = input.int(3, "Toque de banda válido durante (velas)", minval = 0, group = G_REV,
     tooltip = "0 = el toque de la banda debe producirse en la misma vela de la señal.")

// --- Filtros de calidad ---
useAdxFilter  = input.bool(true, "Filtro de rango: ADX de 1h mínimo", group = G_FILT, inline = "adx",
     tooltip = "Con ADX de la confirmación bajo el mercado está en rango: ninguna entrada se gestiona como SWING (como máximo INTRADÍA, objetivo más corto). No bloquea entradas.")
adxMin        = input.float(20, "", minval = 0, step = 1, group = G_FILT, inline = "adx")
adxLen        = input.int(14, "Longitud ADX", minval = 2, group = G_FILT)
adxOnScalps   = input.bool(false, "ADX bajo también bloquea los scalps", group = G_FILT)
pbNeedLtfTurn = input.bool(true, "Pullback: confirmar con CHOCH del LTF", group = G_FILT,
     tooltip = "Secuencia SMC completa: el precio toca la banda BB, toma liquidez y luego el gráfico hace un CHOCH a favor de la tendencia -> entrada en esa vela. Evita entrar mientras el retroceso sigue vivo.")
pbTurnWindow  = input.int(20, "Pullback: velas máx. entre toque de banda y CHOCH", minval = 2, group = G_FILT)
blockCounterScalps = input.bool(true, "Bloquear scalps contra 1h y 4h a la vez", group = G_FILT)
minRiskAtr    = input.float(0.5, "Riesgo mínimo (x ATR)", minval = 0, step = 0.1, group = G_FILT,
     tooltip = "Descarta stops demasiado ajustados, que se barren con el ruido.")
commPct       = input.float(0.04, "Comisión por lado (%) — igual que en Propiedades", minval = 0, step = 0.01, group = G_FILT)
minRiskCost   = input.float(4.0, "Riesgo mínimo (x costo de comisión ida+vuelta)", minval = 0, step = 0.5, group = G_FILT,
     tooltip = "5 = la comisión se come como máximo el 20% del riesgo. En 1m/5m es el filtro que más mejora el resultado.")
tightStopMode = input.string("Ampliar hasta el mínimo", "Si el stop queda muy corto", options = ["Ampliar hasta el mínimo", "Descartar la entrada"], group = G_FILT,
     tooltip = "Ampliar: el stop se aleja hasta el riesgo mínimo (el TP se recalcula con el R:R). Descartar: no se opera. En 5m con BTC, descartar deja casi sin entradas porque la comisión es grande frente al movimiento de cada vela.")
cooldownBars  = input.int(6, "Pausa tras una pérdida (velas, misma dirección)", minval = 0, group = G_FILT)
useSession    = input.bool(false, "Operar sólo en horario", group = G_FILT, inline = "ses")
sessionStr    = input.session("0800-1800", "", group = G_FILT, inline = "ses")
sessionTz     = input.string("America/Argentina/Buenos_Aires", "Zona horaria", group = G_FILT)
minTierOpt    = input.string("Sólo INTRADÍA y SWING", "Tipos de entrada permitidos", options = ["Todos", "Sólo INTRADÍA y SWING", "Sólo SWING"], group = G_FILT,
     tooltip = "En el backtest los SCALP puros (sin la 1h a favor) fueron los que más perdieron. Por defecto sólo se opera cuando la 1h acompaña.")
minTier       = minTierOpt == "Sólo SWING" ? 3 : minTierOpt == "Sólo INTRADÍA y SWING" ? 2 : 1
showStats     = input.bool(true, "Mostrar tabla de estadísticas por tipo", group = G_FILT)

// --- Modo rango ---
useRangeMode  = input.bool(false, "Operar scalps de rango cuando el mercado está lateral", group = G_RANGE,
     tooltip = "Cuando el ADX de la confirmación (1h) está por debajo del mínimo, el mercado está en rango: se compra en la zona baja de la banda de 1h y se vende en la zona alta, tras toma de liquidez + CHOCH del gráfico. Salida rápida y completa en el objetivo, sin runner. Funciona en compras y ventas.")
rangeZonePct  = input.float(25, "Zona de entrada: % extremo de la banda 1h", minval = 5, maxval = 50, step = 5, group = G_RANGE,
     tooltip = "25 = compra sólo si el precio tocó el 25% inferior de la banda de 1h (venta: 25% superior).")
rangeTarget   = input.string("Media BB 1h", "Objetivo del scalp de rango", options = ["Media BB 1h", "Banda opuesta 1h"], group = G_RANGE)
rangeMinRR    = input.float(1.0, "R:R mínimo hasta el objetivo", minval = 0.5, step = 0.25, group = G_RANGE)

// --- Riesgo ---
useRiskSizing = input.bool(true, "Tamaño de posición por riesgo (recomendado)", group = G_RISK,
     tooltip = "Cada operación arriesga un % fijo del capital hasta el stop, sin importar lo lejos que esté. Si se desactiva, usa el tamaño de Propiedades.")
riskPct       = input.float(0.5, "Riesgo por operación (% del capital)", minval = 0.05, maxval = 5, step = 0.05, group = G_RISK)
maxLeverage   = input.float(2.0, "Apalancamiento máximo", minval = 0.1, step = 0.5, group = G_RISK,
     tooltip = "Tope del tamaño de la posición: capital x este valor. Evita posiciones gigantes cuando el stop es muy corto.")
atrLen       = input.int(14, "Longitud ATR", minval = 1, group = G_RISK)
slMode       = input.string("Zona liquidez/FVG", "Pullback BB: referencia del SL", options = ["Vela de entrada", "Zona liquidez/FVG"], group = G_RISK)
slAtrMult    = input.float(1.0, "Pullback BB: colchón SL (x ATR)", minval = 0, step = 0.1, group = G_RISK)
rrScalp      = input.float(1.5, "R:R SCALP (1:X)",    minval = 0.5, step = 0.25, group = G_RISK, inline = "rr")
rrIntra      = input.float(2.0, "INTRADÍA",           minval = 0.5, step = 0.25, group = G_RISK, inline = "rr")
rrSwing      = input.float(3.0, "SWING",              minval = 0.5, step = 0.25, group = G_RISK, inline = "rr")
exitMode     = input.string("Zonas de liquidez HTF", "Gestión de salida", options = ["Zonas de liquidez HTF", "TP fijo", "Parcial + runner"], group = G_RISK,
     tooltip = "Zonas de liquidez HTF: cierra un % en la PRIMERA zona de liquidez de 1h/4h (banda BB opuesta o swing sin romper), pasa a breakeven y deja correr el resto hacia la SIGUIENTE zona con trailing. No corta la ganancia en un R fijo. TP fijo: todo sale en el R:R del tipo. Parcial + runner: parcial en X R.")
useLiqExit   = exitMode == "Zonas de liquidez HTF"
useRunner    = exitMode == "Parcial + runner"
useRoomFilter = input.bool(true, "Exigir recorrido hasta la zona de liquidez HTF", group = G_RISK, inline = "room",
     tooltip = "Antes de entrar mide la distancia hasta el primer obstáculo en contra (banda BB opuesta de 1h/4h, swing high/low sin romper de 1h/4h). Si es menor que X veces el riesgo, no entra: evita comprar en la banda baja del 5m cuando el precio está en la banda alta de 1h.")
minRoomR     = input.float(2.0, "", minval = 0.5, step = 0.25, group = G_RISK, inline = "room")
useMidObs    = input.bool(false, "La media BB de 1h/4h también cuenta como obstáculo", group = G_RISK)
runnerTrailAtr = input.float(3.0, "Runner: trailing tras el 1er objetivo (x ATR)", minval = 0.5, step = 0.25, group = G_RISK)
scalpPartialBB = input.bool(false, "SCALP: TP parcial en la banda BB opuesta", group = G_RISK)
partialPct   = input.int(50, "% a cerrar en el TP parcial", minval = 1, maxval = 99, group = G_RISK)
partialAtR   = input.float(2.0, "Parcial + runner: TP parcial en (R)", minval = 0.25, step = 0.25, group = G_RISK)
moveToBE     = input.bool(true, "INTRADÍA/SWING: mover SL a breakeven", group = G_RISK)
beAtR        = input.float(1.5, "Breakeven cuando el precio llega a (R)", minval = 0.25, step = 0.25, group = G_RISK)
beCostMult   = input.float(1.5, "Breakeven + colchón (x costo de comisión)", minval = 0, step = 0.5, group = G_RISK,
     tooltip = "El stop no se pone exactamente en la entrada sino un poco a favor, para cubrir la comisión.")
trailStartR  = input.float(1.5, "Trailing: se activa desde (R)", minval = 0.5, step = 0.25, group = G_RISK)
trailMode    = input.string("Ninguno", "Trailing stop", options = ["Sólo SWING", "INTRADÍA y SWING", "Ninguno"], group = G_RISK)
trailAtrMult = input.float(2.5, "Trailing: distancia (x ATR)", minval = 0.5, step = 0.25, group = G_RISK)
swingNoFixedTP = input.bool(false, "SWING: sin TP fijo (sólo trailing / estructura)", group = G_RISK)
allowUpgrade = input.bool(true, "Ascender el trade si 1h/4h se alinean después de entrar", group = G_RISK)
closeOnChoch = input.bool(true, "INTRADÍA/SWING: cerrar si hay CHOCH de 1h en contra", group = G_RISK)

// --- Visual ---
visualMode   = input.string("Limpio", "Modo visual", options = ["Limpio", "Completo"], group = G_VIS,
     tooltip = "Limpio: sólo BB del gráfico, etiquetas de COMPRA/VENTA, SL/TP, CHOCH de 1h/4h y el panel. Completo: además BB 1h/4h, zonas de liquidez, FVG, swings, barridos y CHOCH del LTF (las casillas de abajo sólo aplican en modo Completo).")
fullVis      = visualMode == "Completo"
showBbLtf    = input.bool(true,  "Mostrar BB del gráfico (LTF)", group = G_VIS)
showBb1h     = input.bool(true,  "Mostrar BB 1h (escalón violeta)",  group = G_VIS) and fullVis
showBb4h     = input.bool(true,  "Mostrar BB 4h (escalón naranja)",  group = G_VIS) and fullVis
showLiqZone  = input.bool(true,  "Sombrear zonas de liquidez HTF (extremos BB)", group = G_VIS) and fullVis
showFvg      = input.bool(true,  "Mostrar FVG",          group = G_VIS) and fullVis
showStruct   = input.bool(true,  "Mostrar BOS / CHOCH de 4h y 1h", group = G_VIS)
showLtfChoch = input.bool(true,  "Mostrar CHOCH del LTF (rombos)", group = G_VIS) and fullVis
showSwings   = input.bool(true,  "Mostrar swings de liquidez LTF y barridos", group = G_VIS) and fullVis
showLegend   = input.bool(false, "Mostrar leyenda en el panel", group = G_VIS)
panelCompact = input.bool(true,  "Panel compacto (celular)", group = G_VIS,
     tooltip = "Textos cortos y letra chica para que el panel y la tabla entren en la pantalla del celular. TradingView no dibuja las tablas que no entran en el gráfico.")
tblSize      = panelCompact ? size.tiny : size.small
showLevels   = input.bool(true,  "Mostrar niveles SL / TP", group = G_VIS)
showPanel    = input.bool(true,  "Mostrar panel de estado", group = G_VIS)
panelPos     = input.string("Arriba derecha", "Posición del panel", options = ["Arriba derecha", "Arriba izquierda", "Abajo derecha", "Abajo izquierda"], group = G_VIS)

// --- Fechas ---
useDateFilter = input.bool(false, "Limitar rango de fechas", group = G_DATE)
startDate     = input.time(timestamp("2023-01-01T00:00:00"), "Desde", group = G_DATE)
endDate       = input.time(timestamp("2099-12-31T00:00:00"), "Hasta", group = G_DATE)
inDateRange   = not useDateFilter or (time >= startDate and time <= endDate)

// =====================================================================================================
// 2. FUNCIONES DE ESTRUCTURA
// =====================================================================================================
// Estructura de mercado por fractales.
// Códigos de evento: 1 = BOS alcista, 2 = CHOCH alcista, -1 = BOS bajista, -2 = CHOCH bajista.
// BOS  = ruptura al cierre de un swing a favor de la tendencia vigente.
// CHOCH = ruptura al cierre de un swing en contra de la tendencia vigente (cambio de carácter).
f_ms(simple int _piv) =>
    ph = ta.pivothigh(high, _piv, _piv)
    pl = ta.pivotlow(low, _piv, _piv)
    var float swingHigh  = na     // último swing high confirmado (liquidez superior)
    var float swingLow   = na     // último swing low confirmado (liquidez inferior)
    var bool  highBroken = true
    var bool  lowBroken  = true
    var int   trend      = 0      // 1 alcista, -1 bajista, 0 indefinida
    var int   evtType    = 0
    var int   evtCount   = 0      // contador incremental -> permite detectar eventos nuevos
    var float evtLevel   = na
    if not na(ph)
        swingHigh  := ph
        highBroken := false
    if not na(pl)
        swingLow  := pl
        lowBroken := false
    if not highBroken and close > swingHigh
        highBroken := true
        evtType    := trend == 1 ? 1 : 2
        evtLevel   := swingHigh
        evtCount   += 1
        trend      := 1
    else if not lowBroken and close < swingLow
        lowBroken := true
        evtType   := trend == -1 ? -1 : -2
        evtLevel  := swingLow
        evtCount  += 1
        trend     := -1
    [trend, evtType, evtCount, evtLevel, swingHigh, swingLow]

// Función HTF: Bollinger + estructura + FVG. Se ejecuta dentro de request.security().
// Devuelve los valores de la vela HTF ANTERIOR ([1]) -> con lookahead_on = sin repintado.
f_htf(simple int _len, simple float _mult, simple int _piv, simple int _adxLen) =>
    [bbMid, bbUp, bbLo] = ta.bb(close, _len, _mult)
    [diP, diM, adx] = ta.dmi(_adxLen, _adxLen)
    [trend, evtType, evtCount, evtLevel, swHi, swLo] = f_ms(_piv)
    // FVG (desequilibrio de 3 velas). Se guarda el más reciente no mitigado de cada tipo.
    var float bullTop = na
    var float bullBot = na
    var float bearTop = na
    var float bearBot = na
    if low > high[2]
        bullTop := low
        bullBot := high[2]
    if high < low[2]
        bearTop := low[2]
        bearBot := high
    if not na(bullBot) and close < bullBot
        bullTop := na
        bullBot := na
    if not na(bearTop) and close > bearTop
        bearTop := na
        bearBot := na
    [trend[1], evtType[1], evtCount[1], evtLevel[1], bbMid[1], bbUp[1], bbLo[1], close[1],
      bullTop[1], bullBot[1], bearTop[1], bearBot[1], adx[1], swHi[1], swLo[1]]

f_evtText(int e) =>
    e == 1 ? "BOS ↑" : e == 2 ? "CHOCH ↑" : e == -1 ? "BOS ↓" : e == -2 ? "CHOCH ↓" : "—"

f_tfText(string tf) =>
    n = str.tonumber(tf)
    na(n) ? tf : n >= 60 and n % 60 == 0 ? str.tostring(n / 60, "#") + "h" : str.tostring(n, "#") + "m"

f_tierName(int t) =>
    t == 3 ? "SWING" : t == 2 ? "INTRADÍA" : t == 1 ? "SCALP" : "—"

// Color de las etiquetas por DIRECCIÓN (verde = compra, rojo = venta); el tipo va en el texto
f_dirColor(int dir, int t) =>
    dir == 1 ? color.new(color.lime, t == 3 ? 0 : t == 2 ? 15 : 35) : color.new(color.red, t == 3 ? 0 : t == 2 ? 15 : 35)

f_tierDesc(int t, string cName, string mName) =>
    t == 3 ? "SWING (" + cName + "+" + mName + " ✓)" : t == 2 ? "INTRADÍA (" + cName + " ✓)" : "SCALP (sin " + cName + ")"

f_rr(int t) =>
    t == 3 ? rrSwing : t == 2 ? rrIntra : rrScalp

// =====================================================================================================
// 3. DATOS HTF (4h y 1h)
// =====================================================================================================
[tr4, ev4, evc4, evl4, mid4, up4, lo4, cl4, bfT4, bfB4, sfT4, sfB4, adx4, swH4, swL4] = request.security(syminfo.tickerid, tfMacro, f_htf(bbLen, bbMult, pivLenHTF, adxLen), lookahead = barmerge.lookahead_on)
[tr1, ev1, evc1, evl1, mid1, up1, lo1, cl1, bfT1, bfB1, sfT1, sfB1, adx1, swH1, swL1] = request.security(syminfo.tickerid, tfConfirm, f_htf(bbLen, bbMult, pivLenHTF, adxLen), lookahead = barmerge.lookahead_on)

newEvt4h    = ta.change(evc4) != 0 and not na(evc4)
newEvt1h    = ta.change(evc1) != 0 and not na(evc1)
bullChoch1h = newEvt1h and ev1 == 2
bearChoch1h = newEvt1h and ev1 == -2

var int last1hBullChochTime = na
var int last1hBearChochTime = na
if bullChoch1h
    last1hBullChochTime := time
if bearChoch1h
    last1hBearChochTime := time
recentWindowMs   = recent1hBars * timeframe.in_seconds(tfConfirm) * 1000
recent1hBullChoch = not na(last1hBullChochTime) and time - last1hBullChochTime <= recentWindowMs and tr1 == 1
recent1hBearChoch = not na(last1hBearChochTime) and time - last1hBearChochTime <= recentWindowMs and tr1 == -1

// Alineación HTF por dirección (1 = largo, -1 = corto)
f_align1h(int dir) =>
    tr1 == dir
f_align4h(int dir) =>
    tr4 == dir and (not use4hBasisFilter or (dir == 1 ? cl4 > mid4 : cl4 < mid4))
// Nivel (tier) de la operación: 1 SCALP, 2 INTRADÍA (1h a favor), 3 SWING (1h + 4h a favor)
// Filtro de rango: con ADX de 1h bajo, cualquier entrada se gestiona como SCALP
adxOk = not useAdxFilter or nz(adx1) >= adxMin
f_tier(int dir) =>
    base = f_align1h(dir) and f_align4h(dir) ? 3 : f_align1h(dir) ? 2 : 1
    adxOk ? base : math.min(base, 2)

// --- Zonas de liquidez HTF (obstáculos / objetivos) ---
// Candidatos: bandas BB de 1h/4h, swings de 1h/4h y, opcionalmente, las medias BB.
f_liqLevels() =>
    array.from(up1, lo1, up4, lo4, swH1, swL1, swH4, swL4, useMidObs ? mid1 : na, useMidObs ? mid4 : na)
// Nivel más cercano por encima de px (dir = 1) o por debajo (dir = -1), ignorando lo que esté a menos de 'gap'
f_nextLevel(float px, int dir, float gap) =>
    lv = f_liqLevels()
    float best = na
    for v in lv
        if not na(v) and (dir == 1 ? v > px + gap : v < px - gap)
            if na(best) or (dir == 1 ? v < best : v > best)
                best := v
    best

// =====================================================================================================
// 4. LTF: Bollinger, ATR, estructura, swings de liquidez y FVG
// =====================================================================================================
[bbMid, bbUp, bbLo] = ta.bb(bbSrc, bbLen, bbMult)
atr = ta.atr(atrLen)

tfMismatch = not autoTf and timeframe.period != tfEntry
inSession  = not useSession or not na(time(timeframe.period, sessionStr, sessionTz))
canTrade   = inDateRange and inSession and (not blockOnTfMismatch or not tfMismatch)
ltfName    = f_tfText(timeframe.period)
htfName    = f_tfText(tfConfirm)
macroName  = f_tfText(tfMacro)

// --- Estructura del LTF (para el scalping por CHOCH) ---
[trL, evL, evcL, evlL, swHL, swLL] = f_ms(pivLenScalp)
newEvtL     = ta.change(evcL) != 0
bullChochL  = newEvtL and evL == 2
bearChochL  = newEvtL and evL == -2

// --- Swings de liquidez del LTF (fractales) ---
phL = ta.pivothigh(high, pivLenLTF, pivLenLTF)
plL = ta.pivotlow(low,  pivLenLTF, pivLenLTF)
var float ltfSwingHigh = na
var float ltfSwingLow  = na
var line  ltfHighLine  = na
var line  ltfLowLine   = na

if not na(phL)
    ltfSwingHigh := phL
    if showSwings
        ltfHighLine := line.new(bar_index - pivLenLTF, phL, bar_index, phL, color = color.new(color.orange, 30), style = line.style_dotted, extend = extend.right)
if not na(plL)
    ltfSwingLow := plL
    if showSwings
        ltfLowLine := line.new(bar_index - pivLenLTF, plL, bar_index, plL, color = color.new(color.aqua, 30), style = line.style_dotted, extend = extend.right)

// Barrido (sweep): la mecha rompe el swing pero la vela cierra de vuelta dentro -> toma de liquidez
sweepLow  = not na(ltfSwingLow)  and low  < ltfSwingLow  and close > ltfSwingLow
sweepHigh = not na(ltfSwingHigh) and high > ltfSwingHigh and close < ltfSwingHigh

if sweepLow
    if showSwings and not na(ltfLowLine)
        line.set_x2(ltfLowLine, bar_index)
        line.set_extend(ltfLowLine, extend.none)
    ltfSwingLow := na       // la liquidez ya fue tomada
if sweepHigh
    if showSwings and not na(ltfHighLine)
        line.set_x2(ltfHighLine, bar_index)
        line.set_extend(ltfHighLine, extend.none)
    ltfSwingHigh := na

// --- FVG del LTF (gestión con arrays de cajas) ---
var array<box>   bullFvgBoxes = array.new<box>()
var array<float> bullFvgTop   = array.new<float>()
var array<float> bullFvgBot   = array.new<float>()
var array<box>   bearFvgBoxes = array.new<box>()
var array<float> bearFvgTop   = array.new<float>()
var array<float> bearFvgBot   = array.new<float>()

newBullFvg = low > high[2] and (low - high[2]) >= fvgMinAtr * nz(atr)
newBearFvg = high < low[2] and (low[2] - high) >= fvgMinAtr * nz(atr)

if newBullFvg
    array.push(bullFvgTop, low)
    array.push(bullFvgBot, high[2])
    array.push(bullFvgBoxes, showFvg ? box.new(bar_index - 2, low, bar_index, high[2], border_color = color.new(color.green, 60), bgcolor = color.new(color.green, 85), extend = extend.right, text = "FVG", text_color = color.new(color.green, 30), text_size = size.tiny, text_halign = text.align_left) : na)
    if array.size(bullFvgTop) > maxFvgBoxes
        box.delete(array.shift(bullFvgBoxes))
        array.shift(bullFvgTop)
        array.shift(bullFvgBot)

if newBearFvg
    array.push(bearFvgTop, low[2])
    array.push(bearFvgBot, high)
    array.push(bearFvgBoxes, showFvg ? box.new(bar_index - 2, low[2], bar_index, high, border_color = color.new(color.red, 60), bgcolor = color.new(color.red, 85), extend = extend.right, text = "FVG", text_color = color.new(color.red, 30), text_size = size.tiny, text_halign = text.align_left) : na)
    if array.size(bearFvgTop) > maxFvgBoxes
        box.delete(array.shift(bearFvgBoxes))
        array.shift(bearFvgTop)
        array.shift(bearFvgBot)

// Toque y mitigación de FVG (se recorre hacia atrás para poder eliminar elementos)
bool touchBullFvgLtf = false
bool touchBearFvgLtf = false

if array.size(bullFvgTop) > 0
    for i = array.size(bullFvgTop) - 1 to 0
        t = array.get(bullFvgTop, i)
        b = array.get(bullFvgBot, i)
        if not (newBullFvg and i == array.size(bullFvgTop) - 1)   // ignorar la vela que crea el FVG
            if low <= t and high >= b
                touchBullFvgLtf := true
            if close < b  // FVG alcista invalidado
                bx = array.remove(bullFvgBoxes, i)
                if not na(bx)
                    box.set_right(bx, bar_index)
                    box.set_extend(bx, extend.none)
                    box.set_bgcolor(bx, color.new(color.gray, 90))
                    box.set_border_color(bx, color.new(color.gray, 70))
                array.remove(bullFvgTop, i)
                array.remove(bullFvgBot, i)

if array.size(bearFvgTop) > 0
    for i = array.size(bearFvgTop) - 1 to 0
        t = array.get(bearFvgTop, i)
        b = array.get(bearFvgBot, i)
        if not (newBearFvg and i == array.size(bearFvgTop) - 1)
            if high >= b and low <= t
                touchBearFvgLtf := true
            if close > t  // FVG bajista invalidado
                bx = array.remove(bearFvgBoxes, i)
                if not na(bx)
                    box.set_right(bx, bar_index)
                    box.set_extend(bx, extend.none)
                    box.set_bgcolor(bx, color.new(color.gray, 90))
                    box.set_border_color(bx, color.new(color.gray, 70))
                array.remove(bearFvgTop, i)
                array.remove(bearFvgBot, i)

// Toque de FVG de 1h (MTF2)
touchBullFvg1h = not na(bfT1) and low <= bfT1 and high >= bfB1
touchBearFvg1h = not na(sfB1) and high >= sfB1 and low <= sfT1

// Dibujo del FVG activo de 1h (una caja por dirección, se renueva al cambiar)
var box fvg1hBull = na
var box fvg1hBear = na
if showFvg
    if nz(bfT1, -1.0) != nz(bfT1[1], -1.0) or nz(bfB1, -1.0) != nz(bfB1[1], -1.0)
        if not na(fvg1hBull)
            box.set_right(fvg1hBull, bar_index)
            box.set_extend(fvg1hBull, extend.none)
        fvg1hBull := na(bfT1) ? na : box.new(bar_index, bfT1, bar_index + 1, bfB1, border_color = color.new(color.teal, 40), border_style = line.style_dashed, bgcolor = color.new(color.teal, 88), extend = extend.right, text = "FVG " + htfName, text_color = color.teal, text_size = size.tiny, text_halign = text.align_right)
    if nz(sfT1, -1.0) != nz(sfT1[1], -1.0) or nz(sfB1, -1.0) != nz(sfB1[1], -1.0)
        if not na(fvg1hBear)
            box.set_right(fvg1hBear, bar_index)
            box.set_extend(fvg1hBear, extend.none)
        fvg1hBear := na(sfT1) ? na : box.new(bar_index, sfT1, bar_index + 1, sfB1, border_color = color.new(color.maroon, 40), border_style = line.style_dashed, bgcolor = color.new(color.maroon, 88), extend = extend.right, text = "FVG " + htfName, text_color = color.maroon, text_size = size.tiny, text_halign = text.align_right)

// =====================================================================================================
// 5. MOTOR A · PULLBACK BB (a favor de la tendencia MTF)
// =====================================================================================================
bullTrend = f_align4h(1)  and (not use1hStructure or f_align1h(1))
bearTrend = f_align4h(-1) and (not use1hStructure or f_align1h(-1))

touchLower = low  <= bbLo
touchUpper = high >= bbUp
recentLowerTouch = nz(ta.barssince(touchLower), 9999) <= bbTouchLookback
recentUpperTouch = nz(ta.barssince(touchUpper), 9999) <= bbTouchLookback

// Evento SMC (toma de liquidez) cerca de la banda
nearLower = low  <= bbLo + nearBandAtr * atr
nearUpper = high >= bbUp - nearBandAtr * atr

bullLiqEvent = nearLower and (
     (smcUseSweep  and sweepLow) or
     (smcUseFvg    and (touchBullFvgLtf or touchBullFvg1h)) or
     (smcUseHtfLiq and ((not na(lo1) and low <= lo1) or (not na(lo4) and low <= lo4))))
bearLiqEvent = nearUpper and (
     (smcUseSweep  and sweepHigh) or
     (smcUseFvg    and (touchBearFvgLtf or touchBearFvg1h)) or
     (smcUseHtfLiq and ((not na(up1) and high >= up1) or (not na(up4) and high >= up4))))

var int   lastBullLiqBar = na
var int   lastBearLiqBar = na
var float bullLiqLow     = na   // mínimo registrado en la zona de liquidez (para el SL)
var float bearLiqHigh    = na   // máximo registrado en la zona de liquidez (para el SL)

if bullLiqEvent
    bullLiqLow     := na(lastBullLiqBar) or bar_index - lastBullLiqBar > smcLookback ? low : math.min(bullLiqLow, low)
    lastBullLiqBar := bar_index
if bearLiqEvent
    bearLiqHigh    := na(lastBearLiqBar) or bar_index - lastBearLiqBar > smcLookback ? high : math.max(bearLiqHigh, high)
    lastBearLiqBar := bar_index

bullSmcOk = not useSmcFilter or (not na(lastBullLiqBar) and bar_index - lastBullLiqBar <= smcLookback)
bearSmcOk = not useSmcFilter or (not na(lastBearLiqBar) and bar_index - lastBearLiqBar <= smcLookback)

// Confirmación de giro
rng       = high - low
bodyTop   = math.max(open, close)
bodyBot   = math.min(open, close)
lowerWick = bodyBot - low
upperWick = high - bodyTop

bullPin    = rng > 0 and lowerWick >= pinWickRatio * rng and close >= low + rng * 0.5
bearPin    = rng > 0 and upperWick >= pinWickRatio * rng and close <= high - rng * 0.5
bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bullCross  = ta.crossover(close, bbLo)
bearCross  = ta.crossunder(close, bbUp)

bullRevOk = not useRevFilter or (revPin and bullPin) or (revEngulf and bullEngulf) or (revCrossBack and bullCross)
bearRevOk = not useRevFilter or (revPin and bearPin) or (revEngulf and bearEngulf) or (revCrossBack and bearCross)

// Modo confirmado: toque de banda + liquidez dentro de la ventana y CHOCH del LTF a favor en esta vela
touchLowerWin = nz(ta.barssince(touchLower), 9999) <= pbTurnWindow
touchUpperWin = nz(ta.barssince(touchUpper), 9999) <= pbTurnWindow
liqBullWin    = not useSmcFilter or (not na(lastBullLiqBar) and bar_index - lastBullLiqBar <= pbTurnWindow)
liqBearWin    = not useSmcFilter or (not na(lastBearLiqBar) and bar_index - lastBearLiqBar <= pbTurnWindow)
pbLongSetup  = usePullback and bullTrend and (pbNeedLtfTurn ? bullChochL and touchLowerWin and liqBullWin : recentLowerTouch and bullSmcOk and bullRevOk)
pbShortSetup = usePullback and bearTrend and (pbNeedLtfTurn ? bearChochL and touchUpperWin and liqBearWin : recentUpperTouch and bearSmcOk and bearRevOk)

// SL del pullback
// En modo confirmado el SL va por debajo/encima del extremo del retroceso
pbLowWin  = ta.lowest(low, pbTurnWindow)
pbHighWin = ta.highest(high, pbTurnWindow)
pbLongSl  = (pbNeedLtfTurn ? pbLowWin : slMode == "Zona liquidez/FVG" and not na(bullLiqLow)  and useSmcFilter ? math.min(low,  bullLiqLow)  : low)  - slAtrMult * atr
pbShortSl = (pbNeedLtfTurn ? pbHighWin : slMode == "Zona liquidez/FVG" and not na(bearLiqHigh) and useSmcFilter ? math.max(high, bearLiqHigh) : high) + slAtrMult * atr

// =====================================================================================================
// 6. MOTOR B · SCALP CHOCH (agresivo, cualquier LTF)
// =====================================================================================================
// "Viene bajando + toma liquidez + CHOCH alcista" (y el espejo para cortos)
scalpBullLiqEvt = sweepLow  or touchLower or touchBullFvgLtf or touchBullFvg1h or (not na(lo1) and low  <= lo1)
scalpBearLiqEvt = sweepHigh or touchUpper or touchBearFvgLtf or touchBearFvg1h or (not na(up1) and high >= up1)
scalpBullLiqOk  = not scalpReqLiq or nz(ta.barssince(scalpBullLiqEvt), 9999) <= scalpLiqLookback
scalpBearLiqOk  = not scalpReqLiq or nz(ta.barssince(scalpBearLiqEvt), 9999) <= scalpLiqLookback
dispOk          = scalpDispAtr <= 0 or math.abs(close - open) >= scalpDispAtr * atr

scLongSl  = ta.lowest(low,  scalpSlLookback) - scalpSlAtrBuf * atr
scShortSl = ta.highest(high, scalpSlLookback) + scalpSlAtrBuf * atr

useLimit = scalpEntryMode == "Límite en retesteo del nivel roto"
// Precio de entrada del scalp: cierre de la vela CHOCH o retesteo del nivel roto
scLongPx  = useLimit and not na(evlL) and evlL < close ? evlL : close
scShortPx = useLimit and not na(evlL) and evlL > close ? evlL : close

scLongRiskOk  = scLongPx > scLongSl   and (scalpMaxRiskAtr <= 0 or (scLongPx  - scLongSl)  <= scalpMaxRiskAtr * atr)
scShortRiskOk = scShortSl > scShortPx and (scalpMaxRiskAtr <= 0 or (scShortSl - scShortPx) <= scalpMaxRiskAtr * atr)

scAdxOk      = not adxOnScalps or adxOk
scLongSetup  = useScalp and scAdxOk and bullChochL and scalpBullLiqOk and dispOk and scLongRiskOk  and not (scalpBlockVs4h and tr4 == -1) and not (blockCounterScalps and tr1 == -1 and tr4 == -1)
scShortSetup = useScalp and scAdxOk and bearChochL and scalpBearLiqOk and dispOk and scShortRiskOk and not (scalpBlockVs4h and tr4 == 1)  and not (blockCounterScalps and tr1 == 1  and tr4 == 1)

// =====================================================================================================
// 6b. MODO RANGO · scalps rápidos entre los extremos de la banda de 1h cuando el ADX está bajo
// =====================================================================================================
rangeRegime  = useRangeMode and not na(adx1) and not adxOk
bandW1       = up1 - lo1
inLowZone    = not na(bandW1) and low  <= lo1 + bandW1 * rangeZonePct / 100
inHighZone   = not na(bandW1) and high >= up1 - bandW1 * rangeZonePct / 100
rgLowRecent  = nz(ta.barssince(inLowZone),  9999) <= pbTurnWindow
rgHighRecent = nz(ta.barssince(inHighZone), 9999) <= pbTurnWindow
rgLongTp     = rangeTarget == "Media BB 1h" ? mid1 : up1
rgShortTp    = rangeTarget == "Media BB 1h" ? mid1 : lo1
rgLongSetup  = rangeRegime and bullChochL and rgLowRecent  and scalpBullLiqOk and dispOk and close < rgLongTp
rgShortSetup = rangeRegime and bearChochL and rgHighRecent and scalpBearLiqOk and dispOk and close > rgShortTp

// =====================================================================================================
// 6c. MOTOR RUPTURA BB CON TENDENCIA (recomendado, validado en backtest)
// Compra: el gráfico cierra por encima de la banda BB superior (cruce) con estructura alcista en la
// confirmación y en la macro, y la macro cerrando por encima de su media BB. Venta: espejo.
// Stop: extremo de las últimas 5 velas -/+ 0.5 ATR (mínimo 1 ATR). Objetivo: X R.
// =====================================================================================================
boTrendUp    = tr4 == 1  and cl4 > mid4 and tr1 == 1
boTrendDn    = tr4 == -1 and cl4 < mid4 and tr1 == -1
boLongSetup  = useBreakout and boTrendUp and close > bbUp and close[1] <= bbUp[1]
boShortSetup = useBreakout and boTrendDn and close < bbLo and close[1] >= bbLo[1]
boLongSl     = math.min(ta.lowest(low, 5)  - 0.5 * atr, close - atr)
// ---- Respaldo Diario + 4h + 1h (ver G_RS) ----
f_dailyCtx() =>
    s50 = ta.sma(close, 50)
    [trD, evD, evcD, evlD, shD, slD] = f_ms(3)
    upD = close > s50 and trD == 1
    dnD = close < s50 and trD == -1
    [upD[1], dnD[1]]
[dUp, dDn] = request.security(syminfo.tickerid, "D", f_dailyCtx(), lookahead = barmerge.lookahead_on)
respUp  = dUp and tr4 == 1  and cl4 > mid4 and tr1 == 1
respDn  = dDn and tr4 == -1 and cl4 < mid4 and tr1 == -1
rsUseCh = rsTriggers != "Sólo Ruptura BB"
rsUseBb = rsTriggers != "Sólo CHOCH"
rsChL   = rsUseCh and bullChochL and (not rsNeedLiq or scalpBullLiqOk)
rsChS   = rsUseCh and bearChochL and (not rsNeedLiq or scalpBearLiqOk)
rsBbL   = rsUseBb and close > bbUp and close[1] <= bbUp[1]
rsBbS   = rsUseBb and close < bbLo and close[1] >= bbLo[1]
// Estructura de 15m (vela cerrada) para las entradas anticipadas en gráficos menores a 15m
f_tr15() =>
    [t15, e15, c15, l15, h15, s15] = f_ms(2)
    t15[1]
tr15     = request.security(syminfo.tickerid, "15", f_tr15(), lookahead = barmerge.lookahead_on)
anticOn  = rsAntic and chartSec < 900
rsLongSetup  = useRS and respUp and (rsChL or rsBbL) and (not anticOn or tr15 != 1)
rsShortSetup = useRS and respDn and (rsChS or rsBbS) and (not anticOn or tr15 != -1)
rsLo10  = ta.lowest(low, 10)
rsHi10  = ta.highest(high, 10)
boShortSl    = math.max(ta.highest(high, 5) + 0.5 * atr, close + atr)

// =====================================================================================================
// 7. ESTADO DE LA OPERACIÓN Y GESTIÓN
// =====================================================================================================
var int    posDir      = 0      // 1 largo, -1 corto, 0 sin operación
var int    posTier     = 0      // 1 SCALP, 2 INTRADÍA, 3 SWING
var string posType     = ""     // origen de la entrada (texto)
var float  entryRef    = na     // precio de entrada (estimado y luego real)
var float  stopPrice   = na
var float  targetPrice = na
var float  riskR       = na     // distancia de 1R
var float  initQty     = na
var bool   pending     = false  // orden enviada y aún no ejecutada
var int    pendingBar  = na
var bool   pendingLimit = false
var bool   partialDone = false
var bool   beDone      = false
var bool   trailActive = false
var bool   posRange    = false  // scalp de rango: salida completa en el objetivo
var bool   posBO       = false  // ruptura BB con tendencia: objetivo fijo en R
var bool   posRS       = false  // entrada 5m con respaldo D+4h+1h
var float  tp1Liq      = na     // 1er objetivo: primera zona de liquidez HTF
var float  tp2Liq      = na     // 2º objetivo (runner): siguiente zona de liquidez HTF

// Costo de comisión ida+vuelta expresado en precio
f_costDist(float px) =>
    2 * commPct / 100 * px
// Riesgo mínimo: por ATR y por costo de comisión
f_minDist(float px) =>
    math.max(minRiskAtr * atr, minRiskCost * f_costDist(px))
f_riskOk(float dist, float px) =>
    dist > 0 and dist >= f_minDist(px)
widenStops = tightStopMode == "Ampliar hasta el mínimo"

f_trailOn(int t) =>
    trailMode == "INTRADÍA y SWING" ? t >= 2 : trailMode == "Sólo SWING" ? t == 3 : false

// --- 7.1 Ejecución de la orden pendiente / cierre de la operación ---
if pending and strategy.position_size != 0 and math.sign(strategy.position_size) == posDir
    pending   := false
    initQty   := math.abs(strategy.position_size)
    entryRef  := strategy.position_avg_price
    riskR     := math.abs(entryRef - stopPrice)
    if not posRange
        targetPrice := entryRef + posDir * riskR * (posRS ? (rsMgmt == "Scalp 1R" ? rsScalpR : rsTargetR) : posBO ? rrBreakout : f_rr(posTier))

pendingExpired = pending and strategy.position_size == 0 and bar_index > pendingBar + (pendingLimit ? scalpLimitExpiry : 1)
if pendingExpired
    strategy.cancel("Long")
    strategy.cancel("Short")

if pendingExpired or (not pending and posDir != 0 and strategy.position_size == 0)
    posDir      := 0
    posTier     := 0
    posType     := ""
    pending     := false
    entryRef    := na
    stopPrice   := na
    targetPrice := na
    riskR       := na
    initQty     := na
    partialDone := false
    beDone      := false
    trailActive := false
    tp1Liq      := na
    tp2Liq      := na
    posRange    := false
    posBO       := false
    posRS       := false

// --- 7.2 Gestión de la posición abierta ---
inPos = not pending and posDir != 0 and strategy.position_size != 0

if inPos
    // Parcial ejecutado
    if not partialDone and math.abs(strategy.position_size) < initQty * 0.999
        partialDone := true

    // Upgrade: la 1h / 4h se alinea con la operación después de entrar
    newTier = f_tier(posDir)
    if allowUpgrade and newTier > posTier and not posRange
        posTier     := newTier
        if not useLiqExit
            targetPrice := entryRef + posDir * riskR * f_rr(posTier)
        label.new(bar_index, posDir == 1 ? low : high, "⬆ Ahora " + f_tierName(posTier) + " · dejar correr",
             style = posDir == 1 ? label.style_label_up : label.style_label_down, color = f_dirColor(posDir, posTier), textcolor = color.black, size = size.small)

    // Breakeven al alcanzar X R (INTRADÍA / SWING)
    if moveToBE and posTier >= 2 and not beDone and (not posRS or rsMoveBE)
        beR     = posRS ? rsBeR : beAtR
        reached = posDir == 1 ? high >= entryRef + riskR * beR : low <= entryRef - riskR * beR
        if reached
            beDone    := true
            beStop    = entryRef + posDir * beCostMult * f_costDist(entryRef)
            stopPrice := posDir == 1 ? math.max(stopPrice, beStop) : math.min(stopPrice, beStop)

    // Objetivos por zonas de liquidez: se recalculan cada vela (las bandas se mueven)
    if useLiqExit and not posRange and not posBO and not posRS
        t1 = f_nextLevel(entryRef, posDir, 0.0)
        t1 := na(t1) ? entryRef + posDir * riskR * f_rr(posTier) : t1
        // nunca por debajo de 1R: si la zona se acercó, el 1er objetivo queda en 1R
        t1 := posDir == 1 ? math.max(t1, entryRef + riskR) : math.min(t1, entryRef - riskR)
        if not partialDone
            tp1Liq := t1
        tp2Liq      := f_nextLevel(nz(tp1Liq, t1), posDir, 0.5 * riskR)
        targetPrice := na(tp2Liq) ? tp1Liq : tp2Liq
        // tras el 1er objetivo: breakeven + trailing del runner
        if partialDone
            beStop2   = entryRef + posDir * beCostMult * f_costDist(entryRef)
            trailStop = close - posDir * runnerTrailAtr * atr
            stopPrice := posDir == 1 ? math.max(stopPrice, beStop2, trailStop) : math.min(stopPrice, beStop2, trailStop)
            trailActive := true

    // Trailing stop por ATR (se activa a partir de X R a favor)
    if f_trailOn(posTier) and not trailActive and (close - entryRef) * posDir >= trailStartR * riskR
        trailActive := true
    if trailActive
        stopPrice := posDir == 1 ? math.max(stopPrice, close - trailAtrMult * atr) : math.min(stopPrice, close + trailAtrMult * atr)

// Salidas por estructura (se ejecutan tras evaluar las señales para no duplicar una reversa)
exitLongLtf  = inPos and posDir == 1  and posTier == 1 and scalpCloseOnLtfChoch and bearChochL
exitShortLtf = inPos and posDir == -1 and posTier == 1 and scalpCloseOnLtfChoch and bullChochL
exitLongHtf  = inPos and posDir == 1  and posTier >= 2 and closeOnChoch and bearChoch1h and not posRS
exitShortHtf = inPos and posDir == -1 and posTier >= 2 and closeOnChoch and bullChoch1h and not posRS

// --- 7.3 Nuevas señales ---
// Registro de operaciones cerradas: pausa tras pérdida + estadísticas por tipo
// Índices de estadísticas: motor (0 = CHOCH, 1 = Pullback) * 3 + (tier - 1)
var array<int>   stTrades = array.new<int>(9, 0)
var array<int>   stWins   = array.new<int>(9, 0)
var array<float> stGW     = array.new<float>(9, 0.0)
var array<float> stGL     = array.new<float>(9, 0.0)
var int   seenClosed  = 0
var int   lastLossBarL = na
var int   lastLossBarS = na
var int   curTradeBar  = na
var int   curTradeIdx  = na
var float curTradePnl  = 0.0

f_statIdx(string c) =>
    int rg = str.contains(c, " RG") ? 1 : 0
    int t = str.contains(c, "SWING") ? 3 : str.contains(c, "INTRAD") ? 2 : 1
    int e = str.contains(c, " PB") ? 1 : 0
    str.contains(c, " RS") ? 8 : str.contains(c, " BO") ? 7 : rg == 1 ? 6 : e * 3 + t - 1

f_finalize(int idx, float pnl) =>
    if not na(idx)
        array.set(stTrades, idx, array.get(stTrades, idx) + 1)
        if pnl > 0
            array.set(stWins, idx, array.get(stWins, idx) + 1)

if strategy.closedtrades > seenClosed
    for i = seenClosed to strategy.closedtrades - 1
        pnl = strategy.closedtrades.profit(i)
        eb  = strategy.closedtrades.entry_bar_index(i)
        idx = f_statIdx(strategy.closedtrades.entry_comment(i))
        // Cada salida parcial es un registro: se agrupan por vela de entrada para contar operaciones
        if na(curTradeBar) or eb != curTradeBar      // comparar contra na siempre da falso en Pine
            f_finalize(curTradeIdx, curTradePnl)
            curTradeBar := eb
            curTradeIdx := idx
            curTradePnl := 0.0
        curTradePnl += pnl
        if pnl >= 0
            array.set(stGW, idx, array.get(stGW, idx) + pnl)
        else
            array.set(stGL, idx, array.get(stGL, idx) - pnl)
            if strategy.closedtrades.size(i) > 0
                lastLossBarL := bar_index
            else
                lastLossBarS := bar_index
    seenClosed := strategy.closedtrades

coolLongOk  = cooldownBars == 0 or na(lastLossBarL) or bar_index - lastLossBarL > cooldownBars
coolShortOk = cooldownBars == 0 or na(lastLossBarS) or bar_index - lastLossBarS > cooldownBars

flat        = strategy.position_size == 0
canRevShort = allowReverse and strategy.position_size < 0 and posTier == 1
canRevLong  = allowReverse and strategy.position_size > 0 and posTier == 1

longOk  = allowLong  and canTrade and coolLongOk  and barstate.isconfirmed
shortOk = allowShort and canTrade and coolShortOk and barstate.isconfirmed

// Tipo mínimo permitido
longOk  := longOk  and f_tier(1)  >= minTier
shortOk := shortOk and f_tier(-1) >= minTier

// Tamaño por riesgo: capital * riesgo% / distancia al stop, con tope de apalancamiento
f_qty(float entry, float stop) =>
    dist = math.abs(entry - stop)
    dist > 0 ? math.min(strategy.equity * riskPct / 100 / dist, strategy.equity * maxLeverage / entry) : na

// Stops finales (ampliados hasta el riesgo mínimo si corresponde)
scLongSlF  = widenStops ? math.min(scLongSl,  scLongPx  - f_minDist(scLongPx))  : scLongSl
scShortSlF = widenStops ? math.max(scShortSl, scShortPx + f_minDist(scShortPx)) : scShortSl
pbLongSlF  = widenStops ? math.min(pbLongSl,  close - f_minDist(close)) : pbLongSl
pbShortSlF = widenStops ? math.max(pbShortSl, close + f_minDist(close)) : pbShortSl

// Recorrido: distancia hasta la primera zona de liquidez HTF en contra, medida en R
f_roomOk(float px, float sl, int dir) =>
    risk = math.abs(px - sl)
    nxt  = f_nextLevel(px, dir, 0.0)
    not useRoomFilter or na(nxt) or (risk > 0 and math.abs(nxt - px) >= minRoomR * risk)

longScalp  = longOk  and scLongSetup  and (flat or canRevShort) and f_riskOk(scLongPx - scLongSlF, scLongPx)  and f_roomOk(scLongPx, scLongSlF, 1)
shortScalp = shortOk and scShortSetup and (flat or canRevLong)  and f_riskOk(scShortSlF - scShortPx, scShortPx) and f_roomOk(scShortPx, scShortSlF, -1)
longPb     = longOk  and pbLongSetup  and flat and f_riskOk(close - pbLongSlF, close) and f_roomOk(close, pbLongSlF, 1)
shortPb    = shortOk and pbShortSetup and flat and f_riskOk(pbShortSlF - close, close) and f_roomOk(close, pbShortSlF, -1)

// Scalps de rango (no pasan por el filtro de tipo mínimo ni por el de recorrido HTF: su objetivo es la media/banda de 1h)
rgOkL = allowLong  and canTrade and coolLongOk  and barstate.isconfirmed
rgOkS = allowShort and canTrade and coolShortOk and barstate.isconfirmed
longRange  = rgOkL and rgLongSetup  and (flat or canRevShort) and f_riskOk(close - scLongSlF, close)  and (rgLongTp - close)  >= rangeMinRR * (close - scLongSlF)
shortRange = rgOkS and rgShortSetup and (flat or canRevLong)  and f_riskOk(scShortSlF - close, close) and (close - rgShortTp) >= rangeMinRR * (scShortSlF - close)

longBO      = allowLong  and canTrade and coolLongOk  and barstate.isconfirmed and boLongSetup  and flat
shortBO     = allowShort and canTrade and coolShortOk and barstate.isconfirmed and boShortSetup and flat
rsMinL      = f_minDist(close)
rsLongSl    = math.min(rsLo10 - 0.3 * atr, close - rsMinL)
rsShortSl   = math.max(rsHi10 + 0.3 * atr, close + rsMinL)
longRS      = allowLong  and canTrade and coolLongOk  and barstate.isconfirmed and rsLongSetup  and flat
shortRS     = allowShort and canTrade and coolShortOk and barstate.isconfirmed and rsShortSetup and flat
longSignal  = longScalp or longPb or longRange or longBO or longRS
shortSignal = not longSignal and (shortScalp or shortPb or shortRange or shortBO or shortRS)
isRSL       = longRS  and not longScalp  and not longPb  and not longRange  and not longBO
isRSS       = shortRS and not shortScalp and not shortPb and not shortRange and not shortBO
isBOL       = longBO  and not longScalp  and not longPb  and not longRange
isBOS       = shortBO and not shortScalp and not shortPb and not shortRange
isRangeL    = longRange  and not longScalp  and not longPb
isRangeS    = shortRange and not shortScalp and not shortPb

f_entryText(bool isScalp, bool isPb, int dir) =>
    string src = isScalp and isPb ? "CHOCH " + ltfName + " + BB" : isScalp ? "CHOCH " + ltfName : "Pullback BB"
    bool rec1h = dir == 1 ? recent1hBullChoch : recent1hBearChoch
    string conf = rec1h ? " + CHOCH " + htfName : f_align1h(dir) ? " + " + htfName + " ✓" : ""
    src + conf

if longSignal
    posDir      := 1
    posTier     := f_tier(1)
    posType     := f_entryText(longScalp, longPb, 1)
    pendingLimit := longScalp and not longPb and useLimit and scLongPx < close
    entryRef    := longScalp and not longPb ? scLongPx : close
    stopPrice   := longScalp and not longPb ? scLongSlF : pbLongSlF
    riskR       := entryRef - stopPrice
    targetPrice := entryRef + riskR * f_rr(posTier)
    tp1Liq      := useLiqExit ? math.max(nz(f_nextLevel(entryRef, 1, 0.0), targetPrice), entryRef + riskR) : na
    tp2Liq      := useLiqExit ? f_nextLevel(tp1Liq, 1, 0.5 * riskR) : na
    pending     := true
    pendingBar  := bar_index
    initQty     := na
    partialDone := false
    beDone      := false
    trailActive := false
    lastBullLiqBar := na
    posRange    := isRangeL
    posBO       := isBOL
    if isBOL
        posTier      := 3
        posType      := "Ruptura BB " + ltfName + " · " + htfName + "+" + macroName + " ✓"
        pendingLimit := false
        entryRef     := close
        stopPrice    := boLongSl
        riskR        := entryRef - stopPrice
        targetPrice  := entryRef + riskR * rrBreakout
    posRS       := isRSL
    if isRSL
        posTier      := 3
        posType      := (rsChL ? "Liquidez + CHOCH " : "Ruptura BB ") + ltfName + " · D+" + macroName + "+" + htfName + " ✓" + (anticOn ? " · anticipada (15m en retroceso)" : "")
        pendingLimit := false
        entryRef     := close
        stopPrice    := rsLongSl
        riskR        := entryRef - stopPrice
        targetPrice  := entryRef + riskR * (rsMgmt == "Scalp 1R" ? rsScalpR : rsTargetR)
    if isRangeL
        posTier      := 1
        posType      := "Rango " + htfName + " · CHOCH " + ltfName
        pendingLimit := false
        entryRef     := close
        stopPrice    := scLongSlF
        riskR        := entryRef - stopPrice
        targetPrice  := rgLongTp
    entryCmt = isRSL ? "RESPALDO L RS" : isBOL ? "RUPTURA L BO" : isRangeL ? "RANGO L RG" : f_tierName(posTier) + " L" + (longPb ? " PB" : " CH")
    if pendingLimit
        strategy.entry("Long", strategy.long, qty = useRiskSizing ? f_qty(entryRef, stopPrice) : na, limit = entryRef, comment = entryCmt)
    else
        strategy.entry("Long", strategy.long, qty = useRiskSizing ? f_qty(entryRef, stopPrice) : na, comment = entryCmt)
    label.new(bar_index, low, isRSL ? "COMPRA ▲ con respaldo\n" + posType + "\nSL " + str.tostring(stopPrice, format.mintick) + (rsMoveBE ? " · SL a entrada en " + str.tostring(entryRef + riskR * rsBeR, format.mintick) : " (fijo)") + "\nTP1 scalp " + str.tostring(entryRef + riskR * rsScalpR, format.mintick) + " (" + str.tostring(rsScalpR) + "R)" + "\nTP2 tendencia " + str.tostring(entryRef + riskR * rsTargetR, format.mintick) + " (" + str.tostring(rsTargetR) + "R)" : isBOL ? "COMPRA ▲ RUPTURA\n" + posType + "\nTP " + str.tostring(rrBreakout) + "R" : isRangeL ? "COMPRA ▲ RANGO (rápido)\n" + posType + "\nTP " + str.tostring((targetPrice - entryRef) / riskR, "#.#") + "R" : "COMPRA ▲ " + f_tierName(posTier) + "\n" + posType + "\n" + (useLiqExit ? "Recorrido " + str.tostring((tp1Liq - entryRef) / riskR, "#.#") + "R" : "TP 1:" + str.tostring(f_rr(posTier))),
         style = label.style_label_up, color = f_dirColor(1, posTier), textcolor = color.black, size = posTier == 1 ? size.small : size.normal)

if shortSignal
    posDir      := -1
    posTier     := f_tier(-1)
    posType     := f_entryText(shortScalp, shortPb, -1)
    pendingLimit := shortScalp and not shortPb and useLimit and scShortPx > close
    entryRef    := shortScalp and not shortPb ? scShortPx : close
    stopPrice   := shortScalp and not shortPb ? scShortSlF : pbShortSlF
    riskR       := stopPrice - entryRef
    targetPrice := entryRef - riskR * f_rr(posTier)
    tp1Liq      := useLiqExit ? math.min(nz(f_nextLevel(entryRef, -1, 0.0), targetPrice), entryRef - riskR) : na
    tp2Liq      := useLiqExit ? f_nextLevel(tp1Liq, -1, 0.5 * riskR) : na
    pending     := true
    pendingBar  := bar_index
    initQty     := na
    partialDone := false
    beDone      := false
    trailActive := false
    lastBearLiqBar := na
    posRange    := isRangeS
    posBO       := isBOS
    if isBOS
        posTier      := 3
        posType      := "Ruptura BB " + ltfName + " · " + htfName + "+" + macroName + " ✓"
        pendingLimit := false
        entryRef     := close
        stopPrice    := boShortSl
        riskR        := stopPrice - entryRef
        targetPrice  := entryRef - riskR * rrBreakout
    posRS       := isRSS
    if isRSS
        posTier      := 3
        posType      := (rsChS ? "Liquidez + CHOCH " : "Ruptura BB ") + ltfName + " · D+" + macroName + "+" + htfName + " ✓" + (anticOn ? " · anticipada (15m en retroceso)" : "")
        pendingLimit := false
        entryRef     := close
        stopPrice    := rsShortSl
        riskR        := stopPrice - entryRef
        targetPrice  := entryRef - riskR * (rsMgmt == "Scalp 1R" ? rsScalpR : rsTargetR)
    if isRangeS
        posTier      := 1
        posType      := "Rango " + htfName + " · CHOCH " + ltfName
        pendingLimit := false
        entryRef     := close
        stopPrice    := scShortSlF
        riskR        := stopPrice - entryRef
        targetPrice  := rgShortTp
    entryCmt = isRSS ? "RESPALDO S RS" : isBOS ? "RUPTURA S BO" : isRangeS ? "RANGO S RG" : f_tierName(posTier) + " S" + (shortPb ? " PB" : " CH")
    if pendingLimit
        strategy.entry("Short", strategy.short, qty = useRiskSizing ? f_qty(entryRef, stopPrice) : na, limit = entryRef, comment = entryCmt)
    else
        strategy.entry("Short", strategy.short, qty = useRiskSizing ? f_qty(entryRef, stopPrice) : na, comment = entryCmt)
    label.new(bar_index, high, isRSS ? "VENTA ▼ con respaldo\n" + posType + "\nSL " + str.tostring(stopPrice, format.mintick) + (rsMoveBE ? " · SL a entrada en " + str.tostring(entryRef - riskR * rsBeR, format.mintick) : " (fijo)") + "\nTP1 scalp " + str.tostring(entryRef - riskR * rsScalpR, format.mintick) + " (" + str.tostring(rsScalpR) + "R)" + "\nTP2 tendencia " + str.tostring(entryRef - riskR * rsTargetR, format.mintick) + " (" + str.tostring(rsTargetR) + "R)" : isBOS ? "VENTA ▼ RUPTURA\n" + posType + "\nTP " + str.tostring(rrBreakout) + "R" : isRangeS ? "VENTA ▼ RANGO (rápido)\n" + posType + "\nTP " + str.tostring((entryRef - targetPrice) / riskR, "#.#") + "R" : "VENTA ▼ " + f_tierName(posTier) + "\n" + posType + "\n" + (useLiqExit ? "Recorrido " + str.tostring((entryRef - tp1Liq) / riskR, "#.#") + "R" : "TP 1:" + str.tostring(f_rr(posTier))),
         style = label.style_label_down, color = f_dirColor(-1, posTier), textcolor = color.white, size = posTier == 1 ? size.small : size.normal)

// Cierres por CHOCH en contra (si no se ha abierto ya una reversa en esta vela)
if (exitLongLtf or exitLongHtf) and not shortSignal
    strategy.close("Long", comment = "CHOCH " + (exitLongLtf ? ltfName : htfName) + " ↓")
if (exitShortLtf or exitShortHtf) and not longSignal
    strategy.close("Short", comment = "CHOCH " + (exitShortLtf ? ltfName : htfName) + " ↑")

// --- 7.4 Órdenes de salida (se re-envían cada vela con los niveles actualizados) ---
// TP1 = parcial (INTRADÍA/SWING en X R; SCALP opcional en la banda opuesta).  TP2 = resto.
// Ambas órdenes comparten el mismo stop, así el SL / breakeven / trailing cubre toda la posición.
activeCtx = posDir != 0 and (pending or strategy.position_size != 0)
if activeCtx
    finalTp    = posRange or posBO or posRS ? targetPrice : useLiqExit ? tp2Liq : posTier == 3 and swingNoFixedTP ? na : targetPrice
    rsHalf     = posRS and rsMgmt == "Mitad 1R + mitad 3R"
    hasPartial = rsHalf or not posRange and not posBO and not posRS and (useLiqExit or (useRunner and posTier >= 2) or (posTier == 1 and scalpPartialBB))
    tp1Raw     = rsHalf ? entryRef + posDir * riskR * rsScalpR : posRange or posBO or posRS ? targetPrice : useLiqExit ? tp1Liq : posTier >= 2 ? entryRef + posDir * riskR * partialAtR : (posDir == 1 ? bbUp : bbLo)
    tp1Valid   = posDir == 1 ? tp1Raw > close and (na(finalTp) or tp1Raw < finalTp) : tp1Raw < close and (na(finalTp) or tp1Raw > finalTp)
    tp1Limit   = hasPartial and tp1Valid ? tp1Raw : finalTp
    entryId    = posDir == 1 ? "Long" : "Short"
    pfx        = posDir == 1 ? "L" : "S"
    stopInProfit = posDir == 1 ? stopPrice >= entryRef : stopPrice <= entryRef
    lossTxt    = stopInProfit ? (trailActive ? "Trailing" : "Breakeven") : "SL"
    if not partialDone
        strategy.exit(pfx + "-TP1", from_entry = entryId, qty_percent = partialPct, limit = tp1Limit, stop = stopPrice,
             comment_profit = hasPartial and tp1Valid ? (useLiqExit ? "Zona liq. 1" : "TP parcial") : posRange ? "TP rango" : "TP " + f_tierName(posTier), comment_loss = lossTxt)
    strategy.exit(pfx + "-TP2", from_entry = entryId, limit = finalTp, stop = stopPrice,
         comment_profit = posRS ? "TP respaldo" : posBO ? "TP ruptura" : posRange ? "TP rango" : useLiqExit ? "Zona liq. 2" : "TP " + f_tierName(posTier), comment_loss = lossTxt)

// =====================================================================================================
// 8. VISUALIZACIÓN
// =====================================================================================================
// --- Bandas de Bollinger ---
plot(showBbLtf ? bbMid : na, "BB LTF Media", color = color.new(color.gray, 20))
pUpL = plot(showBbLtf ? bbUp : na, "BB LTF Superior", color = color.new(color.blue, 20))
pLoL = plot(showBbLtf ? bbLo : na, "BB LTF Inferior", color = color.new(color.blue, 20))
fill(pUpL, pLoL, color = color.new(color.blue, 95), title = "BB LTF Relleno")

plot(showBb1h ? mid1 : na, "BB 1h Media", color = color.new(color.purple, 40), style = plot.style_stepline)
pUp1 = plot(showBb1h ? up1 : na, "BB 1h Superior", color = color.new(color.purple, 10), style = plot.style_stepline, linewidth = 2)
pLo1 = plot(showBb1h ? lo1 : na, "BB 1h Inferior", color = color.new(color.purple, 10), style = plot.style_stepline, linewidth = 2)

plot(showBb4h ? mid4 : na, "BB 4h Media", color = color.new(color.orange, 30), style = plot.style_stepline, linewidth = 2)
pUp4 = plot(showBb4h ? up4 : na, "BB 4h Superior", color = color.new(color.orange, 0), style = plot.style_stepline, linewidth = 3)
pLo4 = plot(showBb4h ? lo4 : na, "BB 4h Inferior", color = color.new(color.orange, 0), style = plot.style_stepline, linewidth = 3)

// --- Zonas de liquidez HTF (bandas extremas 4h/1h como proxy de stops acumulados) ---
liqPad = nz(atr) * 0.3
pUp4z = plot(showLiqZone and showBb4h ? up4 + liqPad : na, "Liq 4h sup (zona)", color = na, style = plot.style_stepline, display = display.none)
pLo4z = plot(showLiqZone and showBb4h ? lo4 - liqPad : na, "Liq 4h inf (zona)", color = na, style = plot.style_stepline, display = display.none)
fill(pUp4, pUp4z, color = color.new(color.red,   80), title = "Zona liquidez 4h superior")
fill(pLo4, pLo4z, color = color.new(color.green, 80), title = "Zona liquidez 4h inferior")
pUp1z = plot(showLiqZone and showBb1h ? up1 + liqPad : na, "Liq 1h sup (zona)", color = na, style = plot.style_stepline, display = display.none)
pLo1z = plot(showLiqZone and showBb1h ? lo1 - liqPad : na, "Liq 1h inf (zona)", color = na, style = plot.style_stepline, display = display.none)
fill(pUp1, pUp1z, color = color.new(color.red,   88), title = "Zona liquidez 1h superior")
fill(pLo1, pLo1z, color = color.new(color.green, 88), title = "Zona liquidez 1h inferior")

// --- Estructura: BOS / CHOCH de 4h y 1h ---
if showStruct and newEvt4h and ev4 != 0 and (fullVis or math.abs(ev4) == 2)
    bull = ev4 > 0
    line.new(bar_index - 1, evl4, bar_index, evl4, extend = extend.left, color = bull ? color.green : color.red, width = 2, style = ev4 == 2 or ev4 == -2 ? line.style_solid : line.style_dashed)
    label.new(bar_index, evl4, f_tfText(tfMacro) + " " + f_evtText(ev4), style = bull ? label.style_label_up : label.style_label_down, color = bull ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
if showStruct and newEvt1h and ev1 != 0 and (fullVis or math.abs(ev1) == 2)
    bull = ev1 > 0
    line.new(bar_index - 1, evl1, bar_index, evl1, color = bull ? color.new(color.green, 40) : color.new(color.red, 40), width = 1, style = ev1 == 2 or ev1 == -2 ? line.style_solid : line.style_dotted)
    label.new(bar_index, evl1, htfName + " " + f_evtText(ev1), style = bull ? label.style_label_up : label.style_label_down, color = bull ? color.new(color.lime, 30) : color.new(color.orange, 30), textcolor = color.black, size = size.tiny)

// --- CHOCH del LTF (base del scalping) ---
if showLtfChoch and (bullChochL or bearChochL)
    line.new(bar_index - 1, evlL, bar_index, evlL, color = bullChochL ? color.new(color.lime, 20) : color.new(color.fuchsia, 20), width = 1, style = line.style_dashed, extend = extend.left)
plotshape(showLtfChoch and bullChochL, "CHOCH LTF alcista", shape.diamond, location.belowbar, color.new(color.lime, 30),    size = size.tiny)
plotshape(showLtfChoch and bearChochL, "CHOCH LTF bajista", shape.diamond, location.abovebar, color.new(color.fuchsia, 30), size = size.tiny)

// --- Barridos de liquidez LTF ---
plotshape(showSwings and sweepLow,  "Barrido mínimo (liquidez)", shape.xcross, location.belowbar, color.new(color.aqua,   0), size = size.tiny, text = "$")
plotshape(showSwings and sweepHigh, "Barrido máximo (liquidez)", shape.xcross, location.abovebar, color.new(color.orange, 0), size = size.tiny, text = "$")

// --- Niveles SL / TP ---
showLvl = showLevels and strategy.position_size != 0
plot(showLvl ? stopPrice   : na, "Stop Loss / Trailing", color = color.red,  style = plot.style_linebr, linewidth = 2)
plot(showLvl and useLiqExit and not partialDone ? tp1Liq : na, "Objetivo 1 (zona de liquidez)", color = color.new(color.lime, 40), style = plot.style_linebr, linewidth = 1)
plot(showLvl and posRS ? entryRef + posDir * riskR * rsScalpR : na, "TP1 scalp", color = color.new(color.aqua, 20), style = plot.style_linebr, linewidth = 1)
plot(showLvl and posRS and rsMoveBE and not beDone ? entryRef + posDir * riskR * rsBeR : na, "Nivel para mover SL a la entrada", color = color.new(color.yellow, 20), style = plot.style_linebr, linewidth = 1)
plot(showLvl ? targetPrice : na, "Take Profit",          color = color.lime, style = plot.style_linebr, linewidth = 2)
plot(showLvl ? strategy.position_avg_price : na, "Precio entrada", color = color.gray, style = plot.style_linebr)

// --- Fondo según tendencia MTF ---
bgcolor((useRS ? respUp : bullTrend) ? color.new(color.green, 92) : (useRS ? respDn : bearTrend) ? color.new(color.red, 92) : na, title = "Fondo: respaldo / tendencia MTF")

// =====================================================================================================
// 9. PANEL DE ESTADO
// =====================================================================================================
f_pos(string p) =>
    p == "Arriba izquierda" ? position.top_left : p == "Abajo derecha" ? position.bottom_right : p == "Abajo izquierda" ? position.bottom_left : position.top_right

f_trendTxt(int t) =>
    t == 1 ? "ALCISTA ▲" : t == -1 ? "BAJISTA ▼" : "NEUTRAL"

f_trendCol(int t) =>
    t == 1 ? color.new(color.green, 20) : t == -1 ? color.new(color.red, 20) : color.new(color.gray, 20)

var table panel = table.new(f_pos(panelPos), 2, 20, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.gray, frame_width = 1)

// Escribe una fila (etiqueta | valor) y devuelve el índice de la siguiente
f_row(int r, string k, string v, color bg, color tc) =>
    table.cell(panel, 0, r, k, text_color = color.white, text_size = tblSize, text_halign = text.align_left)
    table.cell(panel, 1, r, v, bgcolor = bg, text_color = tc, text_size = tblSize, text_halign = text.align_left)
    r + 1

if showPanel and barstate.islast
    table.clear(panel, 0, 0, 1, 19)
    w = color.white
    int r = 0
    r := f_row(r, "SMC MTF · " + ltfName, entryEngine, na, w)

    // Tendencias
    r := f_row(r, f_tfText(tfMacro), f_trendTxt(tr4) + (cl4 > mid4 ? " · sobre media" : " · bajo media"), f_trendCol(tr4), w)
    r := f_row(r, htfName, f_trendTxt(tr1) + " · " + f_evtText(ev1), f_trendCol(tr1), w)
    r := f_row(r, ltfName, f_trendTxt(trL) + " · " + f_evtText(evL), f_trendCol(trL), w)

    // Sesgo y qué hacer
    biasTxt = bullTrend ? "ALCISTA → COMPRAS" : bearTrend ? "BAJISTA → VENTAS" : "MIXTO → scalps"
    biasCol = bullTrend ? color.new(color.green, 10) : bearTrend ? color.new(color.red, 10) : color.new(color.gray, 30)
    r := f_row(r, "Sesgo " + macroName + "+" + htfName, biasTxt, biasCol, w)
    r := f_row(r, "ADX " + htfName, (adxOk ? "TENDENCIA" : useRangeMode ? "RANGO → scalps" : "RANGO") + " · " + str.tostring(nz(adx1), "#"), adxOk ? color.new(color.teal, 40) : color.new(color.orange, 40), w)
    r := f_row(r, "VENTA sería", f_tierDesc(f_tier(-1), htfName, macroName), color.new(color.red, f_tier(-1) == 3 ? 20 : f_tier(-1) == 2 ? 45 : 75), w)
    r := f_row(r, "COMPRA sería", f_tierDesc(f_tier(1), htfName, macroName), color.new(color.green, f_tier(1) == 3 ? 20 : f_tier(1) == 2 ? 45 : 75), w)
    nextTxt = bearTrend ? (trL == -1 ? "Esperar rebote a BB sup." : "CHOCH ↓ " + ltfName + " = VENTA") :
         bullTrend ? (trL == 1 ? "Esperar retroceso a BB inf." : "CHOCH ↑ " + ltfName + " = COMPRA") :
         "CHOCH " + ltfName + " tras barrido"
    boTxt = boTrendUp ? "Cierre sobre BB sup. = COMPRA" : boTrendDn ? "Cierre bajo BB inf. = VENTA" : "Sin tendencia " + htfName + "+" + macroName + ": no operar"
    rsTxt = respUp ? (anticOn and tr15 == 1 ? "COMPRAS: esperar retroceso del 15m" : "COMPRAS: liquidez + CHOCH ↑ o ruptura BB sup.") : respDn ? (anticOn and tr15 == -1 ? "VENTAS: esperar retroceso del 15m" : "VENTAS: liquidez + CHOCH ↓ o ruptura BB inf.") : "Sin respaldo D+" + macroName + "+" + htfName + ": no operar"
    r := f_row(r, "Respaldo D+" + macroName + "+" + htfName, respUp ? "ALCISTA ✓" : respDn ? "BAJISTA ✓" : "NO", respUp ? color.new(color.green, 20) : respDn ? color.new(color.red, 20) : color.new(color.gray, 40), w)
    r := f_row(r, "Esperar", useRS ? rsTxt : useBreakout and not usePullback ? boTxt : nextTxt, na, color.yellow)
    upLv = f_nextLevel(close, 1, 0.0)
    dnLv = f_nextLevel(close, -1, 0.0)
    r := f_row(r, "Recorrido ↑ / ↓", (na(upLv) ? "libre" : str.tostring((upLv - close) / close * 100, "#.##") + "%") + " / " + (na(dnLv) ? "libre" : str.tostring((close - dnLv) / close * 100, "#.##") + "%"), na, w)

    // Posición
    posTxt = strategy.position_size > 0 ? "COMPRADO · " + f_tierName(posTier) : strategy.position_size < 0 ? "VENDIDO · " + f_tierName(posTier) : pending ? "Orden pendiente" : "Sin posición"
    posCol = strategy.position_size > 0 ? color.new(color.green, 20) : strategy.position_size < 0 ? color.new(color.red, 20) : na
    r := f_row(r, "Posición", posTxt, posCol, w)
    r := f_row(r, "Operaciones", str.tostring(strategy.closedtrades) + " cerradas", na, w)
    if strategy.position_size != 0
        rNow = riskR > 0 ? (close - entryRef) * posDir / riskR : na
        r := f_row(r, "Origen", posType, na, w)
        r := f_row(r, "Ganancia / objetivo", (na(rNow) ? "—" : str.tostring(rNow, "#.##") + "R") + " / " + (posTier == 3 and swingNoFixedTP ? "trailing" : str.tostring(f_rr(posTier), "#.##") + "R"), na, w)

    // Aviso de timeframe
    if tfMismatch
        r := f_row(r, "⚠ Timeframe", "Poné el gráfico en " + f_tfText(tfEntry) + " (ahora " + ltfName + ")" + (blockOnTfMismatch ? " · entradas bloqueadas" : ""), color.new(color.orange, 20), w)

    // Leyenda
    if showLegend
        r := f_row(r, "LEYENDA", "", color.new(color.gray, 60), w)
        r := f_row(r, "Etiqueta verde ▲", "COMPRA (SCALP / INTRADÍA / SWING)", color.new(color.lime, 30), color.black)
        r := f_row(r, "Etiqueta roja ▼", "VENTA (SCALP / INTRADÍA / SWING)", color.new(color.red, 30), w)
        r := f_row(r, "Líneas roja / verde", "Stop Loss / Take Profit activos", na, w)
        r := f_row(r, "Fondo verde / rojo", macroName + " y " + htfName + " de acuerdo (sesgo)", na, w)
        r := f_row(r, "Flechas de TradingView", "Órdenes ejecutadas (entrada / salida)", na, w)
        if fullVis
            r := f_row(r, "Escalón violeta / naranja", "BB " + htfName + " / BB " + macroName + " (zonas de liquidez)", na, w)
            r := f_row(r, "Rombo / $", "CHOCH del " + ltfName + " / barrido de liquidez", na, w)

// --- Tabla de estadísticas por tipo de entrada (para afinar) ---
var table stats = table.new(position.bottom_left, 5, 12, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.gray, frame_width = 1)

f_statRow(int row, string name, int n, int w, float gw, float gl) =>
    pf   = gl > 0 ? gw / gl : na
    net  = gw - gl
    good = n > 0 and net > 0
    bg   = n == 0 ? na : good ? color.new(color.green, 55) : color.new(color.red, 55)
    table.cell(stats, 0, row, name, text_color = color.white, text_size = tblSize, text_halign = text.align_left)
    table.cell(stats, 1, row, str.tostring(n), text_color = color.white, text_size = tblSize)
    table.cell(stats, 2, row, n > 0 ? str.tostring(100.0 * w / n, "#") + "%" : "—", text_color = color.white, text_size = tblSize)
    table.cell(stats, 3, row, n == 0 ? "—" : na(pf) ? "∞" : str.tostring(pf, "#.##"), text_color = color.white, text_size = tblSize)
    table.cell(stats, 4, row, n > 0 ? str.tostring(net, "#.##") : "—", bgcolor = bg, text_color = color.white, text_size = tblSize)

if showStats and barstate.islast
    // Incluir la operación que aún se está agrupando
    array<int> tr = array.copy(stTrades)
    array<int> wn = array.copy(stWins)
    if not na(curTradeIdx)
        array.set(tr, curTradeIdx, array.get(tr, curTradeIdx) + 1)
        if curTradePnl > 0
            array.set(wn, curTradeIdx, array.get(wn, curTradeIdx) + 1)
    hdr = color.new(color.gray, 50)
    table.cell(stats, 0, 0, "Tipo", bgcolor = hdr, text_color = color.white, text_size = tblSize)
    table.cell(stats, 1, 0, "Ops",     bgcolor = hdr, text_color = color.white, text_size = tblSize)
    table.cell(stats, 2, 0, "Acierto", bgcolor = hdr, text_color = color.white, text_size = tblSize)
    table.cell(stats, 3, 0, "PF",      bgcolor = hdr, text_color = color.white, text_size = tblSize)
    table.cell(stats, 4, 0, "Neto",    bgcolor = hdr, text_color = color.white, text_size = tblSize)
    names = array.from("SCALP CH", "INTRA CH", "SWING CH", "SCALP PB", "INTRA PB", "SWING PB", "RANGO", "RUPTURA", "5m RESPALDO")
    int   tn  = 0
    int   tw  = 0
    float tgw = 0.0
    float tgl = 0.0
    for k = 0 to 8
        f_statRow(k + 1, array.get(names, k), array.get(tr, k), array.get(wn, k), array.get(stGW, k), array.get(stGL, k))
        tn  += array.get(tr, k)
        tw  += array.get(wn, k)
        tgw += array.get(stGW, k)
        tgl += array.get(stGL, k)
    f_statRow(10, "TOTAL", tn, tw, tgw, tgl)
    table.cell(stats, 0, 11, "PF > 1 = gana", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)

// =====================================================================================================
// 10. ALERTAS (usar "Crear alerta" -> "alert() function calls only")
// =====================================================================================================
if longSignal
    alert("SMC MTF BB · LONG " + f_tierName(posTier) + " (" + posType + ") en " + syminfo.ticker + " @ " + str.tostring(entryRef, format.mintick) + " | SL " + str.tostring(stopPrice, format.mintick) + " | TP " + str.tostring(targetPrice, format.mintick), alert.freq_once_per_bar_close)
if shortSignal
    alert("SMC MTF BB · SHORT " + f_tierName(posTier) + " (" + posType + ") en " + syminfo.ticker + " @ " + str.tostring(entryRef, format.mintick) + " | SL " + str.tostring(stopPrice, format.mintick) + " | TP " + str.tostring(targetPrice, format.mintick), alert.freq_once_per_bar_close)
if bearChoch1h or bullChoch1h
    alert("SMC MTF BB · CHOCH " + (bullChoch1h ? "alcista" : "bajista") + " en " + htfName + " (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
